# Copy to .dev.vars (git-ignored) for `npx wrangler pages dev .`
# DEV_ADMIN_BYPASS only takes effect when the request host is localhost / 127.0.0.1.
DEV_ADMIN_BYPASS=1
ADMIN_EMAILS=you@example.com
IMPRESSION_SAMPLE_RATE=1
# Leave the Access JWT vars unset locally; there is no Access in front of wrangler.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
