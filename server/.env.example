# Copy to server/.env (git-ignored). See docs/SELF_HOST.md.
DATABASE_URL=mysql://jsonbondhu_app:[PASSWORD]@127.0.0.1:3306/jsonbondhu
# Must match the nginx basic-auth user names on the CMS host.
ADMIN_EMAILS=you@example.com
# nginx authenticates admins and sets Cf-Access-Authenticated-User-Email.
ALLOW_UNVERIFIED_ACCESS_HEADER=1
# MySQL has no write quota, so record every impression.
IMPRESSION_SAMPLE_RATE=1
PUBLIC_DIR=/var/www/jsonbondhu
HOST=127.0.0.1
PORT=8788
